APP_NAME="Bakcang Peneleh"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Jakarta
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---------------------------------------------------------------------
# Database — Laragon MySQL 8.0
# DB_TIMEZONE must match APP_TIMEZONE. The schema uses TIMESTAMP columns,
# which MySQL converts using the *session* timezone; if the two disagree
# every stored time silently shifts.
# ---------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=bakcang_peneleh
DB_USERNAME=root
DB_PASSWORD=
DB_TIMEZONE="+07:00"

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Local dev writes mail to storage/logs/laravel.log.
# Swap MAIL_MAILER=smtp + Mailtrap credentials to inspect real HTML.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="order@bakcangpeneleh.test"
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------------
# Midtrans — Sandbox credentials
# Dashboard: https://dashboard.sandbox.midtrans.com → Settings → Access Keys
#
# MIDTRANS_SERVER_KEY is the webhook signature secret. Never expose it to
# the browser; only CLIENT_KEY is safe in Blade/JS.
# ---------------------------------------------------------------------
MIDTRANS_MERCHANT_ID=
MIDTRANS_CLIENT_KEY=
MIDTRANS_SERVER_KEY=
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_IS_SANITIZED=true
MIDTRANS_IS_3DS=true

# Snap payment page lifetime. Should stay <= the pre-order lead time so an
# unpaid order expires before the kitchen would have needed to start it.
MIDTRANS_EXPIRY_UNIT=hours
MIDTRANS_EXPIRY_DURATION=24

# Where Midtrans posts notifications is set in the Midtrans dashboard, under
# Settings > Configuration > Payment Notification URL — not here. When testing
# through a tunnel, point APP_URL at the ngrok HTTPS URL instead, so the Snap
# finish callback and the invoice QR code resolve from outside this machine.

# ---------------------------------------------------------------------
# Bakcang Peneleh — business rules
# ---------------------------------------------------------------------
BAKCANG_ORDER_PREFIX=BP
BAKCANG_DELIVERY_FEE=15000
BAKCANG_MIN_LEAD_DAYS=1
BAKCANG_MAX_LEAD_DAYS=30
BAKCANG_PICKUP_OPEN=08:00
BAKCANG_PICKUP_CLOSE=17:00

BAKCANG_STORE_NAME="Bakcang Peneleh"
BAKCANG_STORE_PHONE="+62 812-3456-7890"
BAKCANG_STORE_EMAIL="order@bakcangpeneleh.test"
BAKCANG_STORE_ADDRESS="Jl. Peneleh No. 1, Surabaya, Jawa Timur 60274"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
VITE_MIDTRANS_CLIENT_KEY="${MIDTRANS_CLIENT_KEY}"
VITE_MIDTRANS_IS_PRODUCTION="${MIDTRANS_IS_PRODUCTION}"
